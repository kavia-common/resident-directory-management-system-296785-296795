# Backend environment configuration for Resident Directory API

# PostgreSQL connection URL:
# Tip: read resident_directory_database/db_connection.txt for a ready psql string and convert it to DATABASE_URL.
# Example: psql postgresql://appuser:dbuser123@localhost:5000/myapp
# Use the same URL (without 'psql ' prefix) below:
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# JWT settings (change in production)
JWT_SECRET_KEY=please-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
